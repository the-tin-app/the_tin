{
  "name": "tin-backup",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tin-artifacts" }],
  "vars": {
    "FIREBASE_PROJECT_NUMBER": "REPLACE_WITH_GCM_SENDER_ID",
    "FIREBASE_APP_ID": "REPLACE_WITH_GOOGLE_APP_ID"
  },
  "routes": [{ "pattern": "backupthetin.reyes.ai", "custom_domain": true }]
}
