# Consumed by docker-compose.yml, which maps these onto the server's own variables.
# See README.md for the full list and for running without Docker.

# HMAC secret for session tokens. Any long random string:  openssl rand -hex 32
CATALOG_SERVER_SESSION_SECRET=

# "<TEAM_ID>.<BUNDLE_ID>" of the app allowed to attest, e.g. ABCDE12345.com.example.tin
CATALOG_SERVER_APP_ID=
