# The catalog pipeline's configuration. Copy to .env (gitignored) and fill in what the
# command you're running needs — nothing here is required for `npm test`, which uses
# fixtures and never reaches the network.

# ---- Pricing API (pokemonpricetracker) -------------------------------------------
# The one genuinely paid dependency: graded prices and population data. Without it the
# catalog still builds from the free feeds (TCGdex, tcgcsv, Cardmarket), just with no
# PSA columns.
PPT_API_KEY=
# Alternate keys some probe scripts accept in place of PPT_API_KEY.
PPT_BUSINESS=
PPT_PAID=
# Requests per minute. Default 45; the plan's real ceiling is what matters.
PPT_MINUTE_LIMIT=45
# Credit ceiling for one nightly run. Defaults: 130000 overnight sweep, 20000 elsewhere.
PPT_CREDIT_BUDGET=
PPT_DAILY_CREDIT_BUDGET=
# Set to clear a persisted rate-limit halt after an outage, then unset it again.
PPT_CLEAR_RATELIMIT_HALT=

# ---- Bulk export path ------------------------------------------------------------
# UTC hour the upstream generates its daily export, and how many minutes to wait for it.
EXPORT_GEN_UTC_HOUR=6
EXPORT_WAIT_MINS=0
# Where a fetched export is read from / written to.
EXPORT_DIR=
SAVE_DIR=

# ---- Publishing ------------------------------------------------------------------
# Firebase Storage bucket the published tiers are uploaded to.
FIREBASE_STORAGE_BUCKET=

# ---- Funding meter ---------------------------------------------------------------
# GitHub Sponsors account the meter reads. Note that GitHub masks monthly income to 0
# for anyone who is not the sponsorable, so a token belonging to someone else reads $0
# rather than erroring.
GITHUB_SPONSORS_LOGIN=treyes133
GITHUB_TOKEN=
# Fallback goal in cents, used only when the listing has no active goal. Default 15000.
FUNDING_GOAL_CENTS=15000

# ---- Development knobs -----------------------------------------------------------
# Cap the number of sets an overnight sweep touches, for a cheap smoke run.
SWEEP_SET_LIMIT=
# Path to a card-twin overrides JSON consumed by the catalog build.
TWINS_JSON=
